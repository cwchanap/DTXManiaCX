<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dtx-video</AssemblyName>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DTXMania.Automation\DTXMania.Automation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read-only access to the authoritative source config database
         (<source-app-data>/config.db). The recorder never writes or copies
         the database; it only loads rows to serialize the sandbox bootstrap
         Config.ini. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared v1 config-database schema contract, compiled from the game's
         source so the recorder validates config.db exactly like the game
         without taking a project reference (keeps the recorder independent). -->
    <Compile Include="..\DTXMania.Game\Lib\Config\ConfigDbSchema.cs" Link="Config\ConfigDbSchema.cs" />
  </ItemGroup>
</Project>
