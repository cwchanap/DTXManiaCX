<?xml version="1.0" encoding="utf-8"?>
<!--
Share Tech Mono (OFL, see ShareTechMono-OFL.txt), small size for the Drum Key
Mapping page body text and binding chips. ASCII only - CJK text stays on NotoSerifJP.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>ShareTechMono.ttf</FontName>
    <Size>11</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>*</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
